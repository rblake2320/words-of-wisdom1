# Words of Wisdom — environment variables
# Copy to .env for local development. In Manus deployments these are injected
# automatically; outside Manus you must set them yourself.

# MySQL/TiDB connection string (required for any data to load)
DATABASE_URL=mysql://user:password@localhost:3306/words_of_wisdom

# Secret used to sign the session cookie (any long random string)
JWT_SECRET=change-me-to-a-long-random-string

# Public URL of the app (used in email links). Required for standalone
# deployments; on Manus it falls back to the manus.space domain.
APP_URL=http://localhost:3000

# Owner's email. Standalone mode: this account gets the admin role on first
# magic-link login, and receives the owner digest when Manus notifications
# are unavailable.
OWNER_EMAIL=

# ── Manus platform (OPTIONAL — only when deployed on Manus) ──────────────────
# Without these, login uses email magic links (/login, needs RESEND_API_KEY)
# and owner notifications go to OWNER_EMAIL instead.
# Manus OAuth application ID
VITE_APP_ID=
# Manus OAuth backend URL
OAUTH_SERVER_URL=
# Manus open_id of the owner (gets admin role on first login)
OWNER_OPEN_ID=
# Manus notification/forge service (owner digest notifications)
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# ── Optional ──────────────────────────────────────────────────────────────────
# Groq API key for the AI Adviser (https://console.groq.com). Without it the
# adviser returns a friendly placeholder instead of calling the model.
GROQ_API_KEY=

# Resend API key (https://resend.com) for real subscriber email delivery.
# Without it, the admin "send daily notification" action sends an owner
# digest only. Free tier: 3,000 emails/month.
RESEND_API_KEY=
# Verified sender for Resend. Defaults to Resend's shared test sender
# (onboarding@resend.dev) which only delivers to your own account's email —
# verify a domain in Resend and set this before real sends.
EMAIL_FROM="Words of Wisdom <daily@yourdomain.com>"

# Server port (defaults to 3000; falls forward to the next free port)
PORT=3000
